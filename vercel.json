{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "telegram.js",
      "use": "@vercel/node"
    },
    {
      "src": "setup.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/telegram",
      "dest": "telegram.js"
    },
    {
      "src": "/api/setup",
      "dest": "setup.js"
    }
  ]
}
}
